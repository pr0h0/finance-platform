{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Platform",
  "version": "0.1.0",
  "identifier": "me.pr0h0.finplat",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://localhost:3812",
    "beforeBuildCommand": "bun run --cwd ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finance Platform",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Local-first personal finance",
    "longDescription": "Local-first personal finance and expense management. Works offline; optionally syncs with your own server.",
    "copyright": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
