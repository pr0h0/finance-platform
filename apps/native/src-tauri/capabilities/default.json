{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the shared web app",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        }
      ]
    },
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file"
  ]
}
