     "items": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     }
    },
    "currency": {
     "description": "Reporting currency; defaults to profile base currency",
     "type": "string",
     "minLength": 3,
     "maxLength": 3
    },
    "a": {
     "type": "object",
     "properties": {
      "dateFrom": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "dateTo": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
     },
     "required": [
      "dateFrom",
      "dateTo"
     ]
    },
    "b": {
     "type": "object",
     "properties": {
      "dateFrom": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "dateTo": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
     },
     "required": [
      "dateFrom",
      "dateTo"
     ]
    },
    "groupBy": {
     "default": "category",
     "type": "string",
     "enum": [
      "category",
      "merchant",
      "account"
     ]
    }
   },
   "required": [
    "a",
    "b"
   ]
  },
  "scopes": [
   "read_aggregates"
  ]
