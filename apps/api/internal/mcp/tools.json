  "name": "split_transaction",
  "description": "Replace splits; amounts must sum exactly to the transaction amount.",
  "annotations": {
   "readOnlyHint": false
  },
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "transactionId": {
     "type": "string",
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "splits": {
     "minItems": 1,
     "maxItems": 100,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "categoryId": {
        "anyOf": [
         {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
         },
         {
          "type": "null"
         }
        ]
       },
       "amount": {
        "type": "object",
        "properties": {
         "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
         },
         "currency": {
          "type": "string"
         }
        },
        "required": [
         "amount",
         "currency"
        ]
       },
       "description": {
        "default": "",
        "type": "string",
        "maxLength": 500
       }
      },
      "required": [
       "categoryId",
       "amount"
      ]
     }
    },
    "idempotencyKey": {
     "type": "string",
     "maxLength": 200
    }
   },
   "required": [
    "transactionId",
    "splits"
   ]
  },
  "scopes": [
   "edit_splits"
  ]
