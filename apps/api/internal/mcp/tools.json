 {
  "name": "list_transactions",
  "description": "Paginated transactions with filters.",
  "annotations": {
   "readOnlyHint": true
  },
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "profileId": {
     "description": "Defaults to the only profile granted to the client",
     "type": "string",
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "accountIds": {
     "maxItems": 100,
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     }
    },
    "dateFrom": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateTo": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "limit": {
     "default": 100,
     "type": "integer",
     "minimum": 1,
     "maximum": 500
    },
    "cursor": {
     "type": "string"
    },
    "categoryIds": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     }
    },
    "search": {
     "type": "string",
     "maxLength": 200
    },
    "minAmount": {
     "type": "string",
     "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "maxAmount": {
     "type": "string",
     "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "uncategorizedOnly": {
     "default": false,
