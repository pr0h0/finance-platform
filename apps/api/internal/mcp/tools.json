 {
  "name": "create_planned_expense",
  "description": "Create a planned (optionally recurring) expense.",
  "annotations": {
   "readOnlyHint": false
  },
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "profileId": {
     "type": "string",
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "description": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    },
    "amount": {
     "type": "object",
     "properties": {
      "amount": {
       "type": "string",
       "pattern": "^-?\\d+(\\.\\d+)?$"
      },
      "currency": {
       "type": "string"
      }
     },
     "required": [
      "amount",
      "currency"
     ]
    },
    "dueDate": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rrule": {
     "type": "string",
     "maxLength": 500
    },
    "accountId": {
     "type": "string",
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
