      "expected",
      "possible",
      "speculative"
     ]
    },
    "idempotencyKey": {
     "type": "string",
     "maxLength": 200
    }
   },
   "required": [
    "description",
    "amount",
    "dueDate"
   ]
  },
  "scopes": [
   "create_planned"
  ]
