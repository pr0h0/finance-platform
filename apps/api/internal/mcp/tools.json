[
 {
  "name": "get_financial_overview",
  "description": "Balances, net worth, month-to-date income/expenses and upcoming bills.",
  "annotations": {
   "readOnlyHint": true
  },
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "profileId": {
     "description": "Defaults to the only profile granted to the client",
     "type": "string",
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "accountIds": {
     "maxItems": 100,
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
     }
    },
    "currency": {
     "description": "Reporting currency; defaults to profile base currency",
     "type": "string",
     "minLength": 3,
     "maxLength": 3
    },
    "asOf": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   }
  },
  "scopes": [
   "read_aggregates"
  ]
 },
