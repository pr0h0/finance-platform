{
  "name": "finance-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/native",
    "tests/e2e"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages apps/web/src",
    "lint": "biome check .",
    "api:check": "bun run --filter @finplat/api-client check-generated",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "typescript": "5.9.2"
  }
}
