# Finance Platform configuration. Copy to .env (never commit .env). All values are read by the
# API container (apps/api/internal/config). Defaults shown; required ones are marked REQUIRED.

# ---- Server ----
FINPLAT_ENV=production                 # production | development
API_ADDR=:8080                         # listen address inside the api container
PUBLIC_URL=https://fin.pr0h0.me        # public origin; https => Secure cookies (override COOKIE_SECURE)
ALLOWED_ORIGINS=https://fin.pr0h0.me   # comma-separated origins allowed for CORS/CSRF checks
TRUST_PROXY_HEADERS=true               # trust X-Forwarded-For/-Proto from the gateway (api is not published)
# COOKIE_SECURE=true

# ---- Database ----
POSTGRES_USER=finplat
POSTGRES_PASSWORD=                     # REQUIRED: long random string
POSTGRES_DB=finplat
# DATABASE_URL is composed in docker-compose.yml; set it directly when running the api elsewhere.
DB_MAX_CONNS=10
MIGRATE_ON_START=true                  # apply pending migrations at startup (or run `api migrate`)

# ---- Authentication ----
SESSION_TTL=720h                       # Go duration
REGISTRATION_POLICY=first_user         # first_user (only the first account, becomes admin) | open | invite_only | closed

# ---- Attachments ----
STORAGE_BACKEND=local                  # local | s3
ATTACHMENTS_DIR=/data/attachments
MAX_UPLOAD_BYTES=26214400              # 25 MiB
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=finplat
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ---- Currency rates ----
FX_PROVIDERS=ecb                       # comma-separated provider codes; EUR/BAM fixed rate is always built in
FX_REFRESH_INTERVAL=6h

# ---- Background jobs ----
JOBS_ENABLED=true
JOBS_CONCURRENCY=2

# ---- Notifications (optional SMTP) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=finance@example.com

# ---- Backups ----
BACKUP_DIR=/data/backups
BACKUP_SCHEDULE=24h                    # interval between automatic server backups of every profile; "off" disables
BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=               # base64 32 bytes (openssl rand -base64 32); encrypts server backups at rest (AES-256-GCM)

# ---- MCP (AI agent access) ----
MCP_ENABLED=false                      # disabled by default; clients are read-only unless granted
MCP_MAX_RESULTS=500

# ---- Logging ----
LOG_LEVEL=info                         # debug | info | warn | error
LOG_FORMAT=json                        # json | text

# ---- Limits ----
MAX_BODY_BYTES=1048576                 # default JSON body limit (uploads have their own)
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_SYNC_PER_MIN=120
RATE_LIMIT_MCP_PER_MIN=120
RATE_LIMIT_IMPORT_PER_MIN=20
